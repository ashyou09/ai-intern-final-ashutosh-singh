# At least one of these keys is required
OPENROUTER_API_KEY=your-openrouter-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# Model chain: PRIMARY (OpenRouter) → FALLBACK (Groq) → FALLBACK_2 (Groq)
PRIMARY_MODEL=openai/gpt-oss-120b:free
FALLBACK_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL_2=llama-3.1-8b-instant
MAX_TOKENS=2000

# Search tuning (optional)
WEB_RESULTS=6
PAPER_RESULTS=4
PAGES_TO_READ=3        # full text of the top N web results (0 = snippets only)
PLAN_QUERIES=true      # let the model split the topic into focused sub-queries
CACHE_TTL=3600         # seconds to reuse sources for a repeated topic (0 = off)

# Comma-separated allowed origins; "*" allows all (fine for local use)
CORS_ORIGINS=*
